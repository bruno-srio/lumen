using Gtk 4.0;
using Adw 1;

template $LumenWindow : Adw.ApplicationWindow {
  title: _("Lumen");
  default-width: 480;
  default-height: 680;
  width-request: 360;
  height-request: 280;

  Adw.Breakpoint {
    condition ("max-width: 600sp")
  }

  Adw.ToastOverlay toast_overlay {
    Adw.ToolbarView {
      [top]
      Adw.HeaderBar header_bar {
        [start]
        Image app_icon {
          resource: "/io/github/bruno_srio/Lumen/app-icon.svg";
          pixel-size: 32;
          margin-end: 6;
          visible: false;
        }

        [start]
        Button refresh_button {
          icon-name: "view-refresh-symbolic";
          tooltip-text: _("Search Again");
          action-name: "win.refresh";
        }

        [end]
        MenuButton menu_button {
          icon-name: "open-menu-symbolic";
          tooltip-text: _("Main Menu");
          primary: true;
        }

        title-widget: Adw.ViewSwitcher header_switcher {
          stack: section_stack;
          policy: wide;
        };
      }

      [bottom]
      Adw.ViewSwitcherBar section_bar {
        stack: section_stack;
        reveal: true;
      }

      content: Stack stack {
        hexpand: true;
        vexpand: true;

        StackPage {
          name: "searching";
          child: Adw.StatusPage {
            title: _("Looking for lights…");
            description: _("Searching the local network for Yeelight lights.");
            child: Adw.Spinner {};
          };
        }

        StackPage {
          name: "empty";
          child: Adw.StatusPage {
            title: _("No Lights Found");
            description: _("Turn on LAN Control for each light in the Yeelight app, then make sure this computer is on the same network.");
            icon-name: "lightbulb-symbolic";

            child: Box {
              orientation: vertical;
              spacing: 12;
              halign: center;

              Button {
                label: _("Search Again");
                action-name: "win.refresh";
                css-classes: ["pill", "suggested-action"];
                halign: center;
              }

              Button {
                label: _("How to Enable LAN Control");
                action-name: "win.lan-help";
                css-classes: ["flat"];
                halign: center;
              }
            };
          };
        }

        StackPage {
          name: "devices";
          child: Adw.ViewStack section_stack {
            vexpand: true;
            hexpand: true;

            Adw.ViewStackPage {
              name: "lights";
              title: _("Lights");
              icon-name: "lightbulb-symbolic";

              child: ScrolledWindow {
                hscrollbar-policy: never;

                child: Adw.Clamp {
                  maximum-size: 1100;
                  tightening-threshold: 360;
                  valign: start;

                  child: FlowBox devices_box {
                    margin-top: 12;
                    margin-bottom: 24;
                    margin-start: 12;
                    margin-end: 12;
                    row-spacing: 12;
                    column-spacing: 12;
                    selection-mode: none;
                    homogeneous: true;
                    valign: start;
                    vexpand: false;
                    min-children-per-line: 1;
                    max-children-per-line: 3;
                    activate-on-single-click: false;
                  };
                };
              };
            }

            Adw.ViewStackPage {
              name: "groups";
              title: _("Groups");
              icon-name: "view-grid-symbolic";

              child: Stack groups_stack {
                StackPage {
                  name: "list";

                  child: ScrolledWindow {
                    hscrollbar-policy: never;

                    child: Adw.Clamp {
                      maximum-size: 1100;
                      tightening-threshold: 360;
                      valign: start;

                      child: FlowBox groups_box {
                        margin-top: 12;
                        margin-bottom: 24;
                        margin-start: 12;
                        margin-end: 12;
                        row-spacing: 12;
                        column-spacing: 12;
                        selection-mode: none;
                        homogeneous: true;
                        valign: start;
                        vexpand: false;
                        min-children-per-line: 1;
                        max-children-per-line: 3;
                      };
                    };
                  };
                }

                StackPage {
                  name: "empty";

                  child: Adw.StatusPage {
                    title: _("No Groups");
                    description: _("Group lights so one switch controls a room.");
                    icon-name: "view-grid-symbolic";

                    child: Button {
                      label: _("New Group");
                      action-name: "win.new-group";
                      css-classes: ["pill", "suggested-action"];
                      halign: center;
                    };
                  };
                }
              };
            }
          };
        }
      };
    }
  }
}
