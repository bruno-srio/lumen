using Gtk 4.0;
using Adw 1;

template $LumenRenameDialog : Adw.AlertDialog {
  heading: _("Rename Light");
  body: _("This name is stored on this computer. Leave it empty to use the light's own name.");
  close-response: "cancel";

  extra-child: Entry name_entry {
    placeholder-text: _("Bedroom Ceiling");
    activates-default: true;
  };

  responses [
    cancel: _("Cancel"),
    save: _("Save"),
  ]
}
