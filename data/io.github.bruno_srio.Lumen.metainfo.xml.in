<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <name>Lumen</name>
  <summary>Control Yeelight lights on your local network</summary>
  <developer id="io.github.bruno_srio">
    <name>Bruno Ribeiro</name>
  </developer>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <content_rating type="oars-1.1" />
  <branding>
    <color type="primary">#e5a50a</color>
  </branding>
  <description>
    <p>
      Lumen finds Yeelight lights on the local network and lets you turn them on or off, change brightness, and pick a color. It is a native GNOME application and does not need a Yeelight account or an internet connection.
    </p>
    <p>
      LAN Control has to be enabled for each light in the Yeelight mobile app. Names you choose are stored on this computer and stay attached to the light even if its IP address changes.
    </p>
    <p>
      Yeelight is a trademark of its owner. Lumen is an independent project and is not affiliated with Yeelight.
    </p>
  </description>
  <url type="homepage">https://github.com/bruno-srio/lumen</url>
  <url type="vcs-browser">https://github.com/bruno-srio/lumen</url>
  <url type="bugtracker">https://github.com/bruno-srio/lumen/issues</url>
  <url type="donation">https://github.com/sponsors/bruno-srio</url>
  <screenshots>
    <screenshot type="default">
      <caption>The light list, with power, brightness, and color controls</caption>
      <image>https://raw.githubusercontent.com/bruno-srio/lumen/v0.1.1/data/screenshots/lights.png</image>
    </screenshot>
    <screenshot>
      <caption>Lumen in the dark style</caption>
      <image>https://raw.githubusercontent.com/bruno-srio/lumen/v0.1.1/data/screenshots/lights-dark.png</image>
    </screenshot>
  </screenshots>
  <releases>
    <release version="0.1.1" date="2026-11-03">
      <description>
        <p>Power, brightness, and color changes are sent to the lights. Names and addresses are remembered between launches.</p>
      </description>
    </release>
  </releases>
  <recommends>
    <control>pointing</control>
    <control>keyboard</control>
  </recommends>
</component>
